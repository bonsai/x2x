{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bonsai/x2x/blob/main/schemas/recipe.schema.json",
  "title": "x2x Transformation Recipe",
  "type": "object",
  "required": [
    "recipe_id",
    "version",
    "source",
    "target",
    "steps"
  ],
  "properties": {
    "recipe_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/endpoint"
    },
    "target": {
      "$ref": "#/$defs/endpoint"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reversible": {
      "type": "boolean"
    },
    "lossiness": {
      "enum": [
        "lossless",
        "lossy",
        "unknown"
      ]
    },
    "secrets_policy": {
      "const": "external-reference-only"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "domain": {
          "type": "string"
        },
        "platform": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocol": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "object": {
          "type": "string"
        },
        "extension": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "operation"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "uses": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {
          "type": "object"
        },
        "on_error": {
          "enum": [
            "fail",
            "skip",
            "fallback"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
