  "connection_contract": {
    "fields": [
      "id",
      "category",
      "domain",
      "input_types",
      "output_types",
      "interfaces",
      "capabilities",
      "configuration_ref",
      "health_check",
      "version"
    ],
    "rule": "A listed X is a catalog entry, not proof that an adapter is implemented or connected.",
    "adapter_states": [
      "catalogued",
      "planned",
      "implemented",
      "configured",
      "connected",
      "verified",
      "unavailable"
    ],
    "recipe_rule": "Recipes reference X IDs and adapter capabilities rather than hard-coding tool implementations.",
    "security": [
      "Keep secrets outside recipes and registries.",
      "Require explicit authorization for deploy or destructive actions.",
      "Record versions and execution provenance."
    ]
  }
